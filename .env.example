# Environment Configuration for AssemblyAIDictationAPI
# Copy this file to .env and fill in your actual values

# API Base URL
API_BASE_URL=https://api.example.com

# API Authentication
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Optional: API Version
API_VERSION=v1

# Optional: Timeout settings (in seconds)
REQUEST_TIMEOUT=30

# Optional: Debug mode
DEBUG=false

# Opt-in live tests (export/source these variables before running swift test).
# These tests use the global Dictation server, independent of API_BASE_URL above.
ASSEMBLYAI_RUN_LIVE_TESTS=0
ASSEMBLYAI_API_KEY=your_api_key_here
# Optional: defaults to amazing-things.wav in the repository root.
# ASSEMBLYAI_AUDIO_FILE=/absolute/path/to/amazing-things.wav
